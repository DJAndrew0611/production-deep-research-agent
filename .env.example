# ==============================================================================
# Deep Research Agent Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your own API keys.
# NEVER commit your actual .env file or API keys to version control!
# ==============================================================================

# 1. DeepSeek API Configuration (Recommended Default)
# Get key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 2. Firecrawl Web Search & Scraping API Key
# Get key at: https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key-here

# 3. Optional Alternative Providers
# OpenAI API Key: https://platform.openai.com
OPENAI_API_KEY=

# DashScope (Aliyun Qwen) API Key: https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=

# SiliconFlow API Key: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# Custom OpenAI-Compatible Endpoint (Optional)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
